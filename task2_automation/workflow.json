{
  "name": "ConsultBae CSV Duplicate Candidate Checker",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-candidate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger-id",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "data",
        "options": {
          "headerRow": true
        }
      },
      "id": "extract-from-file-id",
      "name": "Extract From File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5001/check-duplicate-bulk",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $input.all().map(item => item.json) }}",
        "options": {}
      },
      "id": "check-duplicates-api-id",
      "name": "HTTP - Check Duplicates (Bulk)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        500,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5001/alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"alert\": \"Duplicate Candidate Detected!\",\n  \"name\": \"{{ $json.name }}\",\n  \"email\": \"{{ $json.email }}\",\n  \"phone\": \"{{ $json.phone }}\",\n  \"existing_record_id\": \"{{ $json.id }}\",\n  \"existing_record_sources\": \"{{ $json.sources }}\"\n}",
        "options": {}
      },
      "id": "send-alert-id",
      "name": "Send Duplicate Alert Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"Duplicate alerts processed successfully.\"\n}",
        "options": {}
      },
      "id": "respond-alert-id",
      "name": "Respond with Alert Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        940,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract From File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract From File": {
      "main": [
        [
          {
            "node": "HTTP - Check Duplicates (Bulk)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Check Duplicates (Bulk)": {
      "main": [
        [
          {
            "node": "Send Duplicate Alert Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Duplicate Alert Webhook": {
      "main": [
        [
          {
            "node": "Respond with Alert Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "csv-duplicate-checker-v6"
}
